generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  auditLogs            AuditLog[]
  integrations         Integration[]
  githubInstallation   GitHubInstallation?
  costRecords          CostRecord[]
  resourceUtilizations ResourceUtilization[]
  githubRepositories GitHubRepository[]
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, actorId])
  @@index([resourceType, resourceId])
}

model Integration {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  provider       IntegrationProvider
  status         IntegrationStatus
  config         Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  githubInstallation   GitHubInstallation?
  costRecords          CostRecord[]
  resourceUtilizations ResourceUtilization[]

  @@index([organizationId])
  @@index([organizationId, provider])
}

model CostRecord {
  id             String   @id @default(uuid())
  organizationId String
  integrationId  String
  externalId     String
  service        String
  team           String?
  project        String?
  environment    String?
  amount         Decimal
  currency       String
  date           DateTime
  region         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalId])
  @@index([organizationId, date])
  @@index([organizationId, service, date])
  @@index([organizationId, team, date])
  @@index([organizationId, project, date])
}

model ResourceUtilization {
  id                 String   @id @default(uuid())
  organizationId     String
  integrationId      String
  resourceId         String
  resourceType       String
  service            String
  cpuUtilization     Decimal?
  memoryUtilization  Decimal?
  networkUtilization Decimal?
  periodStart        DateTime
  periodEnd          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, resourceId, periodStart, periodEnd])
  @@index([organizationId, service])
  @@index([organizationId, resourceType])
  @@index([organizationId, periodStart])
}

model GitHubInstallation {
  id                      String   @id @default(uuid())
  organizationId          String   @unique
  integrationId           String   @unique
  githubInstallationId    Int
  githubOrganizationId    Int
  githubOrganizationLogin String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  repositories GitHubRepository[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, githubOrganizationId])
  @@index([githubOrganizationId])
}

model GitHubRepository {
  id                   String   @id @default(uuid())
  organizationId       String
  githubInstallationId String
  githubRepositoryId   BigInt
  name                 String
  fullName             String
  private              Boolean
  defaultBranch        String?
  htmlUrl              String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  githubInstallation GitHubInstallation @relation(fields: [githubInstallationId], references: [id], onDelete: Cascade)

  @@unique([githubInstallationId, githubRepositoryId])
  @@index([organizationId])
  @@index([githubInstallationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum IntegrationProvider {
  AWS
  GITHUB
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}
